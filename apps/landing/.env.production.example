# Landing · Producción (Vercel project: lynx-landing)

# Base URL pública de landing
LANDING_PUBLIC_URL="https://lynxmedia.cl"

# Supabase Landing (Session pooler / IPv4 compatible)
LANDING_DATABASE_URL="postgresql://USER:PASS@HOST:5432/postgres?sslmode=require"

# Contact form + notificaciones
LANDING_CONTACT_NOTIFY_EMAIL="info@lynxmedia.cl"
LANDING_CONTACT_EMAIL_PROVIDER="brevo"
LANDING_CONTACT_FROM_EMAIL="info@lynxmedia.cl"
LANDING_CONTACT_FROM_NAME="Lynx Media"
LANDING_BREVO_API_KEY=""

# Auto reply
LANDING_CONTACT_SEND_AUTOREPLY="1"
LANDING_CONTACT_AUTOREPLY_SUBJECT="Recibimos tu mensaje · Lynx Media"

# Rate limit
LANDING_CONTACT_RATE_LIMIT_MAX="5"
LANDING_CONTACT_RATE_LIMIT_WINDOW_MS="600000"
