# Landing app database (Supabase proyecto Landing)
LANDING_DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# URL pública de la landing (para enlaces absolutos/correos cuando aplique)
LANDING_PUBLIC_URL="http://localhost:3100"

# Notificación de leads (modo local: se escribe en consola del servidor)
LANDING_CONTACT_NOTIFY_EMAIL="sales@lynxmedia.cl"
LANDING_CONTACT_EMAIL_PROVIDER="console"
LANDING_CONTACT_FROM_EMAIL="noreply@lynxmedia.cl"
LANDING_CONTACT_FROM_NAME="Lynx Media"
LANDING_BREVO_API_KEY=""
LANDING_CONTACT_SEND_AUTOREPLY="0"
LANDING_CONTACT_AUTOREPLY_SUBJECT="Recibimos tu mensaje · Lynx Media"

# Rate limit anti abuso (memoria del proceso)
LANDING_CONTACT_RATE_LIMIT_MAX="5"
LANDING_CONTACT_RATE_LIMIT_WINDOW_MS="600000"
