// ================================================
// File: prisma/schema.prisma
// Título: Esquema Prisma (agrega Track para Fase B)
// Descripción: Define el modelo Track para guardar metadatos y el asset.
// Qué hace: Permite crear/listar tracks reales desde Postgres.
// Peras y manzanas: “Una fila por canción con su info y dónde está el archivo.”
// ================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Usa el pooler en runtime (DATABASE_URL) y el directo para migraciones (DIRECT_URL).
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Post {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model Track {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title    String
  artist   String
  audioUrl String
  coverUrl String?
  moods    String[] // requiere Postgres
  uses     String[]

  // Derechos / licensing
  master          String?
  publishingSplit String? // JSON resumen opcional (legacy/compat)
  
  // Publishing Share
  publishingShares PublishingShare[]


  // // Writer
  // writerName      String? // Ej: "Diego Fernández"
  // writerSharePct  Int? // Ej: 50 (representa 50%)
  // writerIpiNumber String?

  // // Publisher
  // publisherName      String? // Ej: "Lynx Publishing"
  // publisherSharePct  Int? // Ej: 50
  // publisherIpiNumber String?

  // Identificadores / derechos (MVP)
  isrc               String?
  iswc               String?
  upc                String?
  licenseType        String?
  territories        String?
  term               String?
  mediaBuy           String?
  mfn                Boolean?
  restrictions       String[]
  contentIdEnrolled  Boolean?
  contentIdAdmin     String?
  contentIdWhitelist String?

  // Info del asset subido
  assetKey  String @default("") // "external://..." si es URL directa
  assetMime String @default("")
  assetSize Int    @default(0)

  // Campos técnicos (Fase C)
  /// C2 — Campos técnicos de análisis (opcionales)
  durationSec     Int?      @db.Integer // segundos (redondeado)
  loudnessLufs    Float?    @db.DoublePrecision
  // NUEVO:
  loudnessRangeLu Float? // LRA en LU
  lraLowLufs      Float? // LRA low en LUFS
  lraHighLufs     Float? // LRA high en LUFS
  truePeakDbfs    Float? // True Peak en dBFS (negativo)
  waveform        Bytes?
  sampleRateHz    Int?
  channels        Int?
  bitrateKbps     Int?
  analysisAt      DateTime?

  @@index([artist])
  @@index([title])
  @@index([createdAt, id]) // ← nuevo
  @@index([moods], type: Gin) // ← nuevo
  @@index([uses], type: Gin) // ← nuevo
}

enum PublishingRole {
  WRITER
  PUBLISHER
}

model PublishingShare {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relación con Track
  trackId String
  track   Track   @relation(fields: [trackId], references: [id], onDelete: Cascade)

  role      PublishingRole // WRITER o PUBLISHER
  name      String         // Nombre/entidad
  ipiNumber String?        // IPI opcional
  sharePct  Int?           // 0–100 (puede ser null mientras no se complete)
  // pro      String?      // (si quieres agregar luego la sociedad PRO)
}


// ───────────────────────────────────────────────────────────────────────────────
// Modelo para almacenar solicitudes de licencias desde el formulario D3
// ───────────────────────────────────────────────────────────────────────────────
enum Currency {
  CLP
  USD
  EUR
}

// ───────────────────────────────────────────────────────────────────────────────
// Prisma: Estado mínimo del pipeline comercial
// Peras y manzanas:
// - Creamos un enum RequestStatus con 5 estados básicos.
// - Agregamos el campo "status" a LicensingRequest con default NEW.
// - No tocamos nada más del modelo para mantenerlo minimal.
// ───────────────────────────────────────────────────────────────────────────────

enum RequestStatus {
  NEW
  IN_REVIEW
  QUOTED
  CLOSED_WON
  CLOSED_LOST
}

model LicensingRequest {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Responsable (owner) de la gestión comercial de esta solicitud
  assignee String?

  // Solicitante
  name    String
  email   String
  company String?

  // Proyecto
  projectType    String
  media          String?
  territories    String?
  term           String?
  budgetAmount   Int?
  budgetCurrency Currency?
  mfn            Boolean   @default(false)
  needWhitelist  Boolean   @default(false)
  notes          String?

  // Contexto de track
  trackId          String
  trackTitle       String?
  trackArtist      String?
  trackDurationSec Int?
  moods            String[]
  uses             String[]
  restrictions     String[]

  pageUrl String?

  // Respaldo del JSON completo (auditoría)
  rawPayload Json?

  // Estado del pipeline (mínimo viable para gestión)
  status RequestStatus @default(NEW)

  /// Notas internas de gestión (no se envían al cliente)
  internalNotes String? @db.Text

  /// Prioridad de gestión comercial
  priority RequestPriority @default(MEDIUM)

  /// Próximo seguimiento (fecha/hora local convertida a UTC)
  nextFollowUpAt DateTime?

  @@index([createdAt, status])
  @@index([assignee])
  @@index([priority])
  @@index([nextFollowUpAt])
}

// ───────────────────────────────────────────────────────────────────────────────
// Prisma: Seguimiento mínimo (prioridad + próximo follow-up)
// Peras y manzanas:
// - Enum RequestPriority: LOW/MEDIUM/HIGH (por defecto MEDIUM).
// - Campo nextFollowUpAt: fecha/hora opcional del próximo seguimiento.
// - Índices sugeridos para listados y filtros.
// ───────────────────────────────────────────────────────────────────────────────

enum RequestPriority {
  LOW
  MEDIUM
  HIGH
}
